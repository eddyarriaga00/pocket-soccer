{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "global": {
        ".read": "auth != null",
        ".indexOn": [
          "at"
        ],
        "$m": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('bans').child(auth.uid).val() !== true",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.child('uid').val() === auth.uid && newData.child('at').val() === now && (!root.child('last').child(auth.uid).exists() || now - root.child('last').child(auth.uid).val() >= 2500) && newData.parent().parent().parent().child('last').child(auth.uid).val() === now",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "last": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "reports": {
      "$r": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['by', 'uid', 'msg', 'text', 'at']) && newData.child('by').val() === auth.uid && newData.child('at').val() === now",
        "by": {
          ".validate": "newData.isString()"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bans": {
      ".read": false,
      ".write": false
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".write": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".validate": "newData.hasChildren(['at', 'dev', 'z', 'data']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && newData.child('dev').isString() && newData.child('dev').val().length <= 40 && (newData.child('z').val() === 0 || newData.child('z').val() === 1) && newData.child('data').isString() && newData.child('data').val().length <= 6000000",
        "at": {},
        "dev": {},
        "z": {},
        "data": {},
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "players": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "who": {
          "$i": {
            ".validate": "$i.matches(/^[0-2]$/) && newData.isString() && newData.val().length <= 30"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".write": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".validate": "newData.hasChildren(['name', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "soccer": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".write": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'password' || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'github.com')",
        ".validate": "newData.hasChildren(['at', 'dev', 'z', 'data']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && newData.child('dev').isString() && newData.child('dev').val().length <= 40 && newData.child('z').val() === 0 && newData.child('data').isString() && newData.child('data').val().length <= 3000000",
        "at": {},
        "dev": {},
        "z": {},
        "data": {},
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bpark": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".validate": "newData.hasChildren(['n', 'k', 'at']) && newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 16 && newData.child('k').isString() && newData.child('k').val().length <= 2000 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (!newData.child('s').exists() || (newData.child('s').isString() && newData.child('s').val().length <= 160))",
          "$other": {
            ".validate": "$other === 'n' || $other === 'k' || $other === 's' || $other === 'at'"
          }
        }
      }
    },
    "bchal": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "newData.hasChildren(['n', 'at']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (!newData.child('kind').exists() || newData.child('kind').isNumber()) && (!newData.child('room').exists() || (newData.child('room').isString() && newData.child('room').val().length <= 8)) && (!newData.child('ok').exists() || newData.child('ok').isNumber()) && (!newData.child('go').exists() || (newData.child('go').isString() && newData.child('go').val().length <= 80))",
          "$other": {
            ".validate": "$other === 'n' || $other === 'at' || $other === 'kind' || $other === 'room' || $other === 'ok' || $other === 'go'"
          }
        }
      }
    },
    "bgame": {
      "$gid": {
        ".write": "auth != null && !newData.exists() && data.child('m/h').val() === auth.uid",
        "m": {
          ".read": "auth != null && (data.child('h').val() === auth.uid || data.child('g').val() === auth.uid)",
          ".write": "auth != null && !data.exists() && newData.child('h').val() === auth.uid && $gid.beginsWith(auth.uid + '_')",
          ".validate": "newData.hasChildren(['h', 'g', 'at', 'r']) && newData.child('h').isString() && newData.child('g').isString() && newData.child('g').val().length <= 128 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && newData.child('r').isString() && newData.child('r').val().length <= 30000"
        },
        "s": {
          ".read": "auth != null && root.child('bgame').child($gid).child('m/g').val() === auth.uid",
          ".write": "auth != null && root.child('bgame').child($gid).child('m/h').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 12000"
        },
        "i": {
          ".read": "auth != null && root.child('bgame').child($gid).child('m/h').val() === auth.uid",
          ".write": "auth != null && root.child('bgame').child($gid).child('m/g').val() === auth.uid",
          ".validate": "newData.hasChildren(['at'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
